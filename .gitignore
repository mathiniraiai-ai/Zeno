# Working and output directories (keep folder structure via .gitkeep)
work/*
!work/.gitkeep
output/*
!output/.gitkeep

# Environment variables and secrets
.env
.env.*
!.env.example
.zeno_session.json
.zeno_owner_session.json

# Virtual environments
.venv/
venv/
.pytest_cache/

# Raw video footage and scripts (keep folder structure via .gitkeep)
input/footage/*
!input/footage/.gitkeep
input/script/*
!input/script/.gitkeep

# Large (>50MB) native binaries & model weights
tools/ffmpeg/ffmpeg*
tools/ffmpeg/ffprobe*
models/torch/

# Explicitly keep reusable assets, lightweight ONNX face model, and scripts
!assets/**
!models/face_detection_yunet_2023mar.onnx
!scripts/**

# Always ignore Python caches and OS metadata everywhere (must come last)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.DS_Store
**/Thumbs.db

# Reference videos learned from (large; frames and measurements live in styles/<name>/refs/)
input/reference/*
!input/reference/.gitkeep
input/standins/*

# Generated on first run from scripts/align_engine/lexicons/*.py and data/lexicon_db.json (row ids change every run)
scripts/align_engine/kavioo_lexicon.db
zeno_keys.db*

# Owner dev copy marker: installers never move this folder
.zeno-dev
node_modules/
.claude/settings.local.json
app/node_modules/
app/dist/
