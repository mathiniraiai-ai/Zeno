# Working and staging directories (keep folder structure via .gitkeep)
work/*
!work/.gitkeep
output/*
!output/.gitkeep

# Environment variables and session credentials
.env
.env.*
!.env.example
.zeno_session.json
.zeno_owner_session.json

# Virtual environments & test caches
.venv/
venv/
.pytest_cache/

# Raw footage, scripts, voices, and stand-ins (keep .gitkeep)
input/footage/*
!input/footage/.gitkeep
input/script/*
!input/script/.gitkeep
input/voices/*
!input/voices/.gitkeep
input/standins/*
!input/standins/.gitkeep

# Large (>50MB) native binaries & model weights
tools/ffmpeg/ffmpeg*
tools/ffmpeg/ffprobe*
models/torch/

# Explicitly keep reusable assets, segregated formats, ONNX face model, and scripts
!assets/**
!formats/**
!models/face_detection_yunet_2023mar.onnx
!scripts/**

# Generated databases & local Node dependencies
scripts/align_engine/kavioo_lexicon.db
zeno_keys.db*
node_modules/
subtitles/node_modules/
.claude/settings.local.json
.zeno-dev

# Python bytecode and OS metadata everywhere (must come last)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.DS_Store
**/Thumbs.db
app/node_modules/
app/dist/
