{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Read(./.zeno_session.json)",
      "Read(./.zeno_owner_session.json)",
      "Edit(./.zeno_session.json)",
      "Edit(./.zeno_owner_session.json)",
      "Read(./work/_clips/**)",
      "Read(./work/_segments/**)",
      "Read(./work/_logs/**)",
      "Read(./work/*/events.jsonl)",
      "Read(./work/*/_conversation.json)",
      "Read(./styles/*/map.json)",
      "Read(./styles/*/refs/**)"
    ],
    "allow": [
      "Read(./.env.example)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\"; [ -x \"$p\" ] || exit 0; \"$p\" \"$CLAUDE_PROJECT_DIR/scripts/chat_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
