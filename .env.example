# ============================================================================
# Zeno — Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials (NEVER commit .env)
# ============================================================================

# --- Transcription: team members (automatic Google Sign-In) -----------------
# Automatic zero-copy setup (recommended — no manual copy-paste needed):
#   Double-click install.command (macOS) / install.bat (Windows), OR run:
#     python3 scripts/setup.py --login
#   Your browser opens to sign in with your @gosupernova.live Google account,
#   and Zeno automatically grabs and saves your session token into .zeno_session.json and .env.
#
# Never commit .env or .zeno_session.json, and never paste tokens into AI chat.
ZENO_CLOUD_URL=https://zeno-production-bef7.up.railway.app
ZENO_CLOUD_TOKEN=

# Backward-compatible legacy aliases (optional; ZENO_CLOUD_* and .zeno_session.json take precedence):
SCRIPTCUT_CLOUD_URL=https://zeno-production-bef7.up.railway.app
SCRIPTCUT_CLOUD_TOKEN=

# --- Transcription: owner / own Gemini key (only if you do NOT use the service above) ---
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# --- Optional: where finished videos go (default: Downloads/Zeno Outputs) -----
ZENO_OUTPUT_DIR=

# --- Optional Tool & Python Interpreter Overrides ---------------------------
# Leave blank to auto-detect bundled tools/ffmpeg, Homebrew/system ffmpeg, or sibling ScriptCut-AI
FFMPEG_PATH=
# Leave blank to auto-detect .venv or sibling ScriptCut-AI/.venv
CLAUDE_EDITOR_PYTHON=

# --- Optional Default Mark & SFX Pack Styles --------------------------------
# Built-in mark styles: default | glossy | flash | vignette (or custom PNG in assets/marks/)
CLAUDE_EDITOR_MARK_STYLE=default
# Built-in SFX packs: default | supernova | kn20228 | w42
CLAUDE_EDITOR_SFX_PACK=default
