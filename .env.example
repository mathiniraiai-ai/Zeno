# ============================================================================
# Zeno v2.0.0 — Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials (NEVER commit .env)
# ============================================================================

# --- Transcription: team members (automatic Google Sign-In) -----------------
# Recommended zero-copy setup:
#   macOS/Linux: .venv/bin/python scripts/setup.py --login
#   Windows:     .venv\Scripts\python.exe scripts\setup.py --login
# Signs in via browser with your @gosupernova.live Google account and stores
# your session credentials automatically in .zeno_session.json and .env.
# Never commit .env or .zeno_session.json, and never paste secrets into chat.
ZENO_CLOUD_URL=https://zeno-production-bef7.up.railway.app
ZENO_CLOUD_TOKEN=

# Backward-compatible legacy aliases (optional):
SCRIPTCUT_CLOUD_URL=https://zeno-production-bef7.up.railway.app
SCRIPTCUT_CLOUD_TOKEN=

# --- Transcription: direct Gemini API keys (optional fallback) --------------
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# --- Optional: override delivery root (default: ~/Downloads/Zeno Outs/<VideoName>/) ---
ZENO_OUTPUT_DIR=

# --- Optional: FFmpeg & Python Interpreter Overrides ------------------------
# Leave blank to auto-detect tools/ffmpeg or system ffmpeg, and .venv Python
FFMPEG_PATH=
CLAUDE_EDITOR_PYTHON=

# --- Optional: Default Mark & SFX Pack Styles -------------------------------
# Built-in mark styles: default | glossy | flash | vignette
CLAUDE_EDITOR_MARK_STYLE=default
# Built-in SFX packs: default | supernova | kn20228 | w42
CLAUDE_EDITOR_SFX_PACK=default
